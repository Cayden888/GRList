# =====================================================================
# Copy this file to ".env" for local use (never commit .env).
# On Railway, enter the same names under the service's "Variables" tab.
#
# What each mode needs:
#   preview            nothing (uses built-in demo data if no sheet is set)
#   check-sheet        GOOGLE_SHEET_*  (one of the sheet options below)
#   telegram-chat-id   TELEGRAM_BOT_TOKEN
#   post-test          sheet + TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
#   status / resolve   SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#   worker (scheduler) sheet + Supabase, plus Telegram when DRY_RUN=false
# =====================================================================

NODE_ENV=development
TZ=Asia/Kuala_Lumpur
LOG_LEVEL=info

# ---- Google Sheet (public, "Anyone with the link can view") ----
# Easiest: paste the normal sheet link here; it is converted to CSV automatically.
GOOGLE_SHEET_CSV_URL=
# Or give the ID (the long code between /d/ and /edit) plus the tab's gid (the number after gid=)...
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=
# ...or the ID plus the tab's name (used only when GOOGLE_SHEET_GID is empty).
GOOGLE_SHEET_TAB=
# Offline alternative for local testing: a CSV file on disk.
LOCAL_SHEET_CSV_PATH=
SHEET_FETCH_TIMEOUT_MS=15000

# Which row to show each day: random | sequential | fixed
SELECTION_STRATEGY=random
# Only for SELECTION_STRATEGY=fixed: an item id, Image_Name or Title_EN
SELECTION_ITEM_ID=
# Current Value: "generate" (random within min/max, default) or "sheet" (use the Current_Value column)
CURRENT_VALUE_SOURCE=generate
# Simulated "Time Since Last Update" when the sheet leaves it blank (minutes)
SIM_TIME_SINCE_UPDATE_MIN_MINUTES=3
SIM_TIME_SINCE_UPDATE_MAX_MINUTES=45

# ---- Supabase (server-only secrets) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_MS=30000
TELEGRAM_CAPTION_ENABLED=true

# ---- Safety switches (keep these until the preview and test post look right) ----
ENABLE_SCHEDULER=false
DRY_RUN=true

# ---- Image ----
DASHBOARD_OUTPUT_DIR=output
DASHBOARD_WIDTH=1600
DASHBOARD_HEIGHT=900
# Design: control (Plant Pulse control-room layout, default), pro (report with simulated 24H chart), gamer (neon HUD) or clean
DASHBOARD_THEME=control
# Must keep the word SIMULATED (the disclosure cannot be removed)
SIMULATED_DATA_LABEL=SIMULATED DATA

# ---- Schedule (Malaysia time, 24-hour HH:MM) ----
POST_WINDOW_START=10:30
POST_WINDOW_END=17:00

# ---- Retries and recovery ----
MAX_ATTEMPTS=4
RETRY_DELAYS_MINUTES=2,10,30
# If the worker was offline at the scheduled time and comes back later than this, skip the day.
MISSED_JOB_GRACE_MINUTES=90
# How often the worker re-checks the database and logs a heartbeat (minutes)
WORKER_CHECK_INTERVAL_MINUTES=15
# How long a claimed job stays reserved for one worker (seconds)
JOB_LEASE_SECONDS=300
# Optional label for this worker in the database (defaults to Railway's replica id)
INSTANCE_ID=
